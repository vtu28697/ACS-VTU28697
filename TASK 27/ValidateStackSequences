#PROGRAM 
class Solution {
    public boolean validateStackSequences(int[] pushed, int[] popped) {
        int[] stack = new int[pushed.length];
        int top = -1;
        int j = 0;

        for (int x : pushed) {
            stack[++top] = x;

            while (top >= 0 && j < popped.length && stack[top] == popped[j]) {
                top--;
                j++;
            }
        }

        return j == popped.length;
    }
}
#INPUT
Input
pushed =
[1,2,3,4,5]
popped =
[4,5,3,2,1]
#OUTPUT
true
