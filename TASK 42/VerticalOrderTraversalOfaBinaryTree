import java.util.*;

class Solution {

    public List<List<Integer>> verticalTraversal(TreeNode root) {

        // Store: [row, column, value]
        List<int[]> nodes = new ArrayList<>();

        dfs(root, 0, 0, nodes);

        // Sort by:
        // 1. column
        // 2. row
        // 3. value
        Collections.sort(nodes, (a, b) -> {
            if (a[1] != b[1]) {
                return Integer.compare(a[1], b[1]);
            }

            if (a[0] != b[0]) {
                return Integer.compare(a[0], b[0]);
            }

            return Integer.compare(a[2], b[2]);
        });

        List<List<Integer>> result = new ArrayList<>();

        int previousColumn = Integer.MIN_VALUE;

        for (int[] node : nodes) {
            int row = node[0];
            int column = node[1];
            int value = node[2];

            // New column
            if (column != previousColumn) {
                result.add(new ArrayList<>());
                previousColumn = column;
            }

            result.get(result.size() - 1).add(value);
        }

        return result;
    }

    private void dfs(TreeNode node, int row, int column,
                     List<int[]> nodes) {

        if (node == null) {
            return;
        }

        nodes.add(new int[]{row, column, node.val});

        // Left child
        dfs(node.left, row + 1, column - 1, nodes);

        // Right child
        dfs(node.right, row + 1, column + 1, nodes);
    }
}
#INPUT
root =
[3,9,20,null,null,15,7]
#OUTPUT
[[9],[3,15],[20],[7]]
